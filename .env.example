# ---------------------------------------------------------------------------
# Authentication (single pre-set user)
# ---------------------------------------------------------------------------
# Generate AUTH_PASSWORD_HASH and AUTH_SECRET with:  npm run hash-password
#
# IMPORTANT: inside a .env file the `$` characters of a bcrypt hash must be
# escaped as `\$`, because dotenv would otherwise expand them and silently
# blank out part of the hash (every login would then fail as "wrong password").
# The script prints the escaped form ready to paste. When you pass the hash
# straight to `docker run -e` instead, use the unescaped version.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH="\$2b\$12\$replace-with-your-own-hash"
# Convenience alternative for a first run; AUTH_PASSWORD_HASH wins when both are set.
# AUTH_PASSWORD=
# Required, 32+ characters. The app refuses to start without it.
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Leave unset to auto-detect; force with true/false when behind a reverse proxy.
# COOKIE_SECURE=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Inside Docker this points at the mounted volume.
DATABASE_PATH=/data/selfbank.db

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Set to "off" to disable automatic posting of recurring transactions.
RECURRING_CRON=on
